# Copy to .env and fill in.

# Folder containing your ebooks. Windows (Docker Desktop): use forward slashes.
BOOKS_DIR=C:/Users/YourName/Books
# BOOKS_DIR=/home/you/Books

# Required. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MCP_AUTH_TOKEN=change-me

# Port on this machine (container always listens on 8787)
HOST_PORT=8787

# true = include Calibre for MOBI/AZW3/FB2/DOCX support (bigger image). Rebuild after changing.
INSTALL_CALIBRE=false

# Optional tuning
# BOOK_SPLITTER_MAX_TOKENS=12000
# BOOK_SPLITTER_MIN_TOKENS=400
# BOOK_SPLITTER_WORDS_PER_PAGE=300
